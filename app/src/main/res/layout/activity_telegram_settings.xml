<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:background="#102A43"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Telegram 알림 설정"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="NG Alert Configuration"
                android:textColor="#D9E2EC"
                android:textSize="14sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="14dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp">

            <Switch
                android:id="@+id/switchTelegramEnabled"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Telegram 자동 알림 사용"
                android:textColor="#102A43"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Bot Token"
                android:textColor="#334E68"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/editBotToken"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="4dp"
                android:background="#F4F6F8"
                android:hint="123456789:AA..."
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#102A43"
                android:textColorHint="#829AB1"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="※ Token은 소스코드가 아니라 휴대폰 내부에 암호화 저장됩니다."
                android:textColor="#627D98"
                android:textSize="11sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Chat ID"
                android:textColor="#334E68"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/editChatIds"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="4dp"
                android:background="#F4F6F8"
                android:gravity="top|start"
                android:hint="개인 또는 단체방 Chat ID를 한 줄에 하나씩 입력"
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textColor="#102A43"
                android:textColorHint="#829AB1"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="여러 명 또는 단체방을 동시에 등록할 수 있습니다."
                android:textColor="#627D98"
                android:textSize="11sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="전송 기준"
                android:textColor="#334E68"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <Spinner
                android:id="@+id/spinnerAlertPolicy"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="4dp"
                android:background="#F4F6F8"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>

            <Switch
                android:id="@+id/switchSendImage"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="결과 이미지 함께 전송"
                android:textColor="#102A43"
                android:textSize="15sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvTelegramStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="14dp"
            android:background="#FFFFFF"
            android:minHeight="90dp"
            android:padding="14dp"
            android:text="설정을 확인해주세요."
            android:textColor="#486581"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/btnSaveTelegramSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="14dp"
            android:text="Telegram 설정 저장"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnTelegramBack"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="24dp"
            android:text="메뉴로 돌아가기"
            android:textSize="15sp"/>
    </LinearLayout>
</ScrollView>
