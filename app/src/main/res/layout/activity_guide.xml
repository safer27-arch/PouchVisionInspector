<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 상단 헤더 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="#102A43">

            <TextView
                android:id="@+id/tvGuideTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="검사 안내"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGuideSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Inspection Guide"
                android:textColor="#D9E2EC"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- 샘플 이미지 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="12dp"
            android:padding="8dp"
            android:orientation="vertical"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="정상 / 주의 / 불량 예시"
                android:textColor="#102A43"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgGuideSample"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:contentDescription="검사 샘플 이미지" />

            <TextView
                android:id="@+id/tvSampleNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="6dp"
                android:text="※ 이해를 돕기 위한 시뮬레이션 예시입니다."
                android:textColor="#C62828"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 검사 목적 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:padding="16dp"
            android:orientation="vertical"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="검사 목적"
                android:textColor="#102A43"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGuidePurpose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#486581"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <!-- ROI 위치 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:padding="16dp"
            android:orientation="vertical"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="권장 ROI 위치"
                android:textColor="#102A43"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGuideRoi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#486581"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <!-- 판정 포인트 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:padding="16dp"
            android:orientation="vertical"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="주요 판정 포인트"
                android:textColor="#102A43"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGuidePoints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#486581"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <!-- 검사 방법 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:padding="16dp"
            android:orientation="vertical"
            android:background="#EAF2F8">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="검사 방법"
                android:textColor="#102A43"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGuideMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#486581"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <!-- 중요 주의 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:padding="14dp"
            android:background="#FFF3E0"
            android:text="※ 현재 샘플의 정상·주의·불량 이미지는 검사 방법을 설명하기 위한 시뮬레이션입니다. 실제 양산 OK/NG 판정은 현장 승인 Spec, Master Sample 및 실제 불량품 검증을 통해 기준을 설정해야 합니다."
            android:textColor="#7A4F01"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />

        <Button
            android:id="@+id/btnGuideBack"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="24dp"
            android:text="메뉴로 돌아가기"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#102A43" />

    </LinearLayout>

</ScrollView>
