<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:background="#102A43"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Telegram 알림 설정"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="NG Alert Configuration"
                android:textColor="#D9E2EC"
                android:textSize="14sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="14dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp">

            <Switch
                android:id="@+id/switchTelegramEnabled"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Telegram 자동 알림 사용"
                android:textColor="#102A43"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Bot Token"
                android:textColor="#334E68"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/editBotToken"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="4dp"
                android:background="#F4F6F8"
                android:hint="123456789:AA..."
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#102A43"
                android:textColorHint="#829AB1"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="※ Token은 소스코드가 아니라 휴대폰 내부에 암호화 저장됩니다."
                android:textColor="#627D98"
                android:textSize="11sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Chat ID"
                android:textColor="#334E68"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/editChatIds"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="4dp"
                android:background="#F4F6F8"
                android:gravity="top|start"
                android:hint="개인 또는 단체방 Chat ID를 한 줄에 하나씩 입력"
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textColor="#102A43"
                android:textColorHint="#829AB1"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="여러 명 또는 단체방을 동시에 등록할 수 있습니다."
                android:textColor="#627D98"
                android:textSize="11sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="전송 기준"
                android:textColor="#334E68"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <Spinner
                android:id="@+id/spinnerAlertPolicy"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="4dp"
                android:background="#F4F6F8"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>

            <Switch
                android:id="@+id/switchSendImage"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="결과 이미지 함께 전송"
                android:textColor="#102A43"
                android:textSize="15sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="14dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dashboard 정기 Summary"
                android:textColor="#102A43"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <Switch
                android:id="@+id/switchDashboardSummary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:text="정기 Summary 자동 전송"
                android:textColor="#102A43"
                android:textSize="15sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="전송 주기"
                android:textColor="#334E68"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <Spinner
                android:id="@+id/spinnerDashboardInterval"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="4dp"
                android:background="#F4F6F8"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>

            <Switch
                android:id="@+id/switchDashboardZeroWarning"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="검사 0건이면 미실시 경고"
                android:textColor="#102A43"
                android:textSize="14sp"/>

            <Switch
                android:id="@+id/switchDashboardMissingWarning"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="일부 검사 항목 0건이면 누락 경고"
                android:textColor="#102A43"
                android:textSize="14sp"/>

            <Switch
                android:id="@+id/switchDashboardLowCountWarning"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="전체 검사 횟수 부족 경고"
                android:textColor="#102A43"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="최소 검사 건수"
                android:textColor="#334E68"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <Spinner
                android:id="@+id/spinnerDashboardMinCount"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="4dp"
                android:background="#F4F6F8"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="※ 현재 선택된 Model / Line의 최근 주기 데이터를 집계합니다.&#10;※ 기본값: 6시간 / 최소 4건 / 미실시·누락·부족 경고 ON"
                android:textColor="#627D98"
                android:textSize="11sp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnDashboardSummaryTest"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="14dp"
            android:text="SUMMARY 지금 테스트 전송"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvTelegramStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="14dp"
            android:background="#FFFFFF"
            android:minHeight="90dp"
            android:padding="14dp"
            android:text="설정을 확인해주세요."
            android:textColor="#486581"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/btnSaveTelegramSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="14dp"
            android:backgroundTint="#102A43"
            android:text="Telegram 설정 저장"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnTelegramTest"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="14dp"
            android:backgroundTint="#335C81"
            android:text="테스트 메시지 보내기"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnTelegramBack"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#486581"
            android:text="메뉴로 돌아가기"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"/>
    </LinearLayout>
</ScrollView>
