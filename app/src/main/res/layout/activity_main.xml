<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 상단 제목 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="#102A43">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pouch Vision Inspector"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bottom Corner Wrinkle Inspection"
                android:textColor="#D9E2EC"
                android:textSize="12sp"/>

        </LinearLayout>


        <!-- 이미지 / 카메라 영역 -->
        <FrameLayout
            android:id="@+id/imageArea"
            android:layout_width="match_parent"
            android:layout_height="430dp"
            android:layout_margin="10dp"
            android:background="#000000">

            <!-- 카메라 -->
            <androidx.camera.view.PreviewView
                android:id="@+id/previewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>


            <!-- 선택 또는 촬영 이미지 -->
            <ImageView
                android:id="@+id/imagePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000"
                android:scaleType="matrix"
                android:visibility="gone"/>


            <!-- ROI -->
            <View
                android:id="@+id/roiGuide"
                android:layout_width="220dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:background="@drawable/roi_border"
                android:elevation="8dp"/>


            <!-- 안내 -->
            <TextView
                android:id="@+id/tvRoiInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="12dp"
                android:background="#AA000000"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="ROI를 검사 부위에 맞춰주세요"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>

        </FrameLayout>


        <!-- 확대 안내 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:text="사진: 두 손가락 확대/축소 · 확대 후 한 손가락 이동"
            android:textColor="#486581"
            android:textSize="12sp"/>


        <!-- 결과 -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:padding="12dp"
            android:text="카메라 준비 중..."
            android:textColor="#102A43"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="#FFFFFF"/>


        <!-- 사진 / 갤러리 / 검사 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <Button
                android:id="@+id/btnCapture"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="사진 촬영"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/btnGallery"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:text="갤러리 선택"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/btnInspect"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:text="ROI 검사"
                android:textSize="13sp"/>

        </LinearLayout>


        <!-- ROI 가로 조절 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp">

            <Button
                android:id="@+id/btnRoiWidthSmaller"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="가로 -"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/btnRoiWidthLarger"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="가로 +"
                android:textSize="13sp"/>

        </LinearLayout>


        <!-- ROI 세로 조절 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp">

            <Button
                android:id="@+id/btnRoiHeightSmaller"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="세로 -"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/btnRoiHeightLarger"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="세로 +"
                android:textSize="13sp"/>

        </LinearLayout>


        <!-- ROI 중앙 / 사진 원래크기 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <Button
                android:id="@+id/btnRoiReset"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="ROI 중앙"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/btnImageReset"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="사진 원래크기"
                android:textSize="13sp"/>

        </LinearLayout>


        <!-- 카메라 복귀 -->
        <Button
            android:id="@+id/btnCameraMode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="16dp"
            android:text="카메라 화면으로 돌아가기"
            android:textSize="13sp"/>

    </LinearLayout>

</ScrollView>
