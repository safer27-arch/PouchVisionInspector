<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="#102A43"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pouch Vision Inspector"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tab Position Inspection"
                android:textColor="#D9E2EC"
                android:textSize="12sp"/>

        </LinearLayout>

        <!-- 카메라 / 이미지 -->
        <FrameLayout
            android:id="@+id/tabImageArea"
            android:layout_width="match_parent"
            android:layout_height="430dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:background="#000000">

            <androidx.camera.view.PreviewView
                android:id="@+id/tabPreviewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:implementationMode="compatible"
                app:scaleType="fitCenter"/>

            <ImageView
                android:id="@+id/tabImagePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000"
                android:contentDescription="TAB 검사 이미지"
                android:scaleType="matrix"
                android:visibility="gone"/>

            <View
                android:id="@+id/tabRoiGuide"
                android:layout_width="220dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:background="@drawable/roi_border"
                android:elevation="8dp"/>

            <TextView
                android:id="@+id/tvTabGuide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="12dp"
                android:background="#AA000000"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:text="Tab과 주변 Seal을 ROI에 포함해주세요"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>

        </FrameLayout>

        <!-- ROI 조절 : 이미지 바로 아래 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp">

            <Button
                android:id="@+id/btnTabRoiWidthSmaller"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:text="가로 −"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/btnTabRoiWidthLarger"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:text="가로 +"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/btnTabRoiHeightSmaller"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:text="세로 −"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/btnTabRoiHeightLarger"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:text="세로 +"
                android:textSize="12sp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="2dp"
            android:paddingEnd="10dp">

            <Button
                android:id="@+id/btnTabRoiReset"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="ROI 중앙"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/btnTabImageReset"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:text="사진 원래크기"
                android:textSize="12sp"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="사진: 두 손가락 확대/축소 · 확대 후 한 손가락 이동"
            android:textColor="#627D98"
            android:textSize="11sp"/>

        <!-- 촬영 / 갤러리 / 검사 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <Button
                android:id="@+id/btnTabCapture"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="사진 촬영"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/btnTabGallery"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:text="갤러리"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/btnTabInspect"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:text="TAB 검사"
                android:textSize="12sp"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnTabCameraMode"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="6dp"
            android:text="카메라 화면으로 돌아가기"
            android:textSize="12sp"/>

        <!-- 촬영 표준화 가이드 -->
        <Button
            android:id="@+id/btnTabCaptureGuide"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:text="TAB 촬영 가이드"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <!-- 민감도 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="10dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TAB 민감도 설정"
                android:textColor="#102A43"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvTabSensitivityValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="현재 민감도 : 60%"
                android:textColor="#102A43"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="낮음"
                    android:textColor="#486581"
                    android:textSize="12sp"/>

                <SeekBar
                    android:id="@+id/seekTabSensitivity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="60"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="높음"
                    android:textColor="#486581"
                    android:textSize="12sp"/>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="민감도를 높이면 Tab 주변의 작은 위치 변화와 Edge 차이도 더 많이 검출합니다."
                android:textColor="#627D98"
                android:textSize="11sp"/>

            <Button
                android:id="@+id/btnTabSensitivityReset"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:text="기본값 60%로 복원"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- 상태 -->
        <TextView
            android:id="@+id/tvTabStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="70dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="10dp"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:text="카메라를 준비합니다."
            android:textColor="#102A43"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <!-- 검사 결과 -->
        <TextView
            android:id="@+id/tvTabMetrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="220dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="10dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="Position Error    : -&#10;Tilt Error        : -&#10;Spacing Error     : -&#10;Local Deformation : -&#10;Tab Score         : -&#10;&#10;판정 : -"
            android:textColor="#102A43"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/btnTabSaveResult"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="8dp"
            android:text="검사 결과 저장"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/btnTabBack"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="18dp"
            android:text="메뉴로 돌아가기"
            android:textSize="13sp"/>

    </LinearLayout>

</ScrollView>
