<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 상단 헤더 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="#102A43">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seal Inspection"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Seal Width / Straightness / Wrinkle / Deformation"
                android:textColor="#D9E2EC"
                android:textSize="12sp"/>

        </LinearLayout>


        <!-- 이미지 영역 -->
        <FrameLayout
            android:id="@+id/sealImageArea"
            android:layout_width="match_parent"
            android:layout_height="430dp"
            android:layout_margin="12dp"
            android:background="#000000">

            <ImageView
                android:id="@+id/sealImagePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000"
                android:scaleType="matrix"/>

            <!-- Seal ROI -->
            <View
                android:id="@+id/sealRoiGuide"
                android:layout_width="260dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/roi_border"
                android:elevation="8dp"/>

            <TextView
                android:id="@+id/tvSealGuide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="12dp"
                android:background="#AA000000"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="Seal 영역을 ROI 박스에 맞춰주세요"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>

        </FrameLayout>


        <!-- 확대 안내 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:text="사진: 두 손가락 확대/축소 · 확대 후 한 손가락 이동"
            android:textColor="#486581"
            android:textSize="12sp"/>


        <!-- 상태 -->
        <TextView
            android:id="@+id/tvSealStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="76dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:padding="12dp"
            android:text="갤러리에서 Seal 사진을 선택해주세요."
            android:textColor="#102A43"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="#FFFFFF"/>


        <!-- 갤러리 / 검사 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <Button
                android:id="@+id/btnSealGallery"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="갤러리 선택"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btnSealInspect"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="SEAL 검사"
                android:textSize="14sp"/>

        </LinearLayout>


        <!-- ROI 가로 조절 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp">

            <Button
                android:id="@+id/btnSealRoiWidthSmaller"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="가로 -"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/btnSealRoiWidthLarger"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="가로 +"
                android:textSize="13sp"/>

        </LinearLayout>


        <!-- ROI 세로 조절 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp">

            <Button
                android:id="@+id/btnSealRoiHeightSmaller"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="세로 -"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/btnSealRoiHeightLarger"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="세로 +"
                android:textSize="13sp"/>

        </LinearLayout>


        <!-- ROI / 이미지 초기화 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/btnSealRoiReset"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="ROI 중앙"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/btnSealImageReset"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="사진 원래크기"
                android:textSize="13sp"/>

        </LinearLayout>


        <!-- 분석 결과 제목 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:text="Seal Analysis"
            android:textColor="#102A43"
            android:textSize="18sp"
            android:textStyle="bold"/>


        <!-- 분석 결과 -->
        <TextView
            android:id="@+id/tvSealMetrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:text="Seal Width       : -&#10;Straightness    : -&#10;Wrinkle Level   : -&#10;Deformation     : -&#10;Seal Score      : -&#10;&#10;판정 : -"
            android:textColor="#102A43"
            android:textSize="15sp"/>


        <!-- 뒤로가기 -->
        <Button
            android:id="@+id/btnSealBack"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="20dp"
            android:text="메인 메뉴로 돌아가기"
            android:textSize="14sp"/>

    </LinearLayout>

</ScrollView>
