<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 상단 헤더 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="#102A43">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="검사 결과 · 이력"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Inspection History"
                android:textColor="#D9E2EC"
                android:textSize="14sp"/>

        </LinearLayout>

        <!-- 요약 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="14dp"
            android:padding="16dp"
            android:orientation="vertical"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="검사 요약"
                android:textColor="#102A43"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvHistorySummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="저장된 검사 결과가 없습니다."
                android:textColor="#486581"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp"/>

        </LinearLayout>

        <!-- 필터 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="14dp"
            android:padding="14dp"
            android:orientation="vertical"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="검사 이력 필터"
                android:textColor="#102A43"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <!-- Model 필터 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Model"
                android:textColor="#334E68"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <Spinner
                android:id="@+id/spinnerHistoryModel"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:background="#F4F6F8"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>

            <!-- Line 필터 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Line"
                android:textColor="#334E68"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <Spinner
                android:id="@+id/spinnerHistoryLine"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:background="#F4F6F8"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>

            <!-- 검사 항목 필터 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="검사 항목"
                android:textColor="#334E68"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <Spinner
                android:id="@+id/spinnerInspectionType"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:background="#F4F6F8"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>

        </LinearLayout>

        <!-- 최근 검사 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="14dp"
            android:padding="14dp"
            android:orientation="vertical"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="최근 검사 결과"
                android:textColor="#102A43"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:id="@+id/historyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEmptyHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:gravity="center"
                    android:text="아직 저장된 검사 결과가 없습니다."
                    android:textColor="#829AB1"
                    android:textSize="14sp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Telegram 전송 이력 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="14dp"
            android:padding="14dp"
            android:orientation="vertical"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Telegram 전송 이력"
                android:textColor="#102A43"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvTelegramDeliverySummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="전송 이력을 확인하는 중입니다."
                android:textColor="#486581"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"/>

            <LinearLayout
                android:id="@+id/telegramDeliveryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEmptyTelegramDelivery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:gravity="center"
                    android:text="아직 Telegram 전송 이력이 없습니다."
                    android:textColor="#829AB1"
                    android:textSize="14sp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- 향후 확장 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="14dp"
            android:padding="14dp"
            android:orientation="vertical"
            android:background="#EAF2F8">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="관리 기능"
                android:textColor="#102A43"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="• Model / Line별 검사 이력 조회&#10;• 기간별 Trend / 통계&#10;• 검사 항목별 Score 관리&#10;• CSV 내보내기&#10;• 검사 이미지 이력 관리&#10;• Telegram 전송 성공/실패 및 재전송 관리"
                android:textColor="#486581"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"/>

        </LinearLayout>

        <!-- 버튼 -->
        <Button
            android:id="@+id/btnHistoryRefresh"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="14dp"
            android:text="새로고침"
            android:textSize="15sp"/>

        <Button
            android:id="@+id/btnHistoryBack"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="24dp"
            android:text="메뉴로 돌아가기"
            android:textSize="15sp"/>

    </LinearLayout>

</ScrollView>
